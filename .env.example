# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL (local docker-compose) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fuelbuddy
MYSQL_USER=fuelbuddy
MYSQL_PASSWORD=fuelbuddy

# --- Backend ---
# development enables /docs, /redoc, /openapi.json; production disables them.
ENVIRONMENT=development
# SQLAlchemy URL. Local docker-compose: mysql+pymysql://fuelbuddy:fuelbuddy@mysql:3306/fuelbuddy
# Production (TiDB/Aiven): mysql+pymysql://<user>:<password>@<host>:<port>/<database>?ssl_mode=VERIFY_IDENTITY
DATABASE_URL=mysql+pymysql://fuelbuddy:fuelbuddy@localhost:3306/fuelbuddy

# Single-user seed: on startup, if no user exists, create one with these credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# Exact origin of the deployed frontend, used for CORS allow-list (no wildcard).
FRONTEND_ORIGIN=http://localhost:3000

# SMTP for "forgot password" emails. Leave blank to disable email sending;
# use `uv run python -m app.cli reset-password` as a fallback instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend ---
# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000
